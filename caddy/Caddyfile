http://figgy.local {
    root * /srv/landing
    file_server
}

https://figgy.local {
    tls internal

    handle /mcp* {
        reverse_proxy host.docker.internal:8086
    }

    handle_path /helloworld* {
        reverse_proxy helloworld:8080
    }

    handle {
        root * /srv/landing
        file_server
    }
}
